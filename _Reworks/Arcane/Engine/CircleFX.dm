proc/CircleFXM(sc, deg)
	var/matrix/M = matrix()
	M.Scale(sc)
	if(deg) M.Turn(deg)
	return M

proc/CircleFXPart(ic, st, add, big)
	var/obj/circlefx/P
	if(add) P = new /obj/circlefx/add
	else P = new /obj/circlefx
	P.icon = ic
	P.icon_state = st
	if(big)
		P.pixel_x = -32
		P.pixel_y = -32
		P.transform = CircleFXM(0.5, 0)
	return P

proc/CircleFXSpin(obj/O, dps, sc)
	if(!O || !dps) return
	var/seg = 1200 / abs(dps)
	var/step = dps > 0 ? 120 : -120
	animate(O, transform = CircleFXM(sc, step), time = seg, loop = -1)
	animate(transform = CircleFXM(sc, step * 2), time = seg)
	animate(transform = CircleFXM(sc, 0), time = seg)

proc/CircleFXTick(obj/O, datum/circlefx_part/P, sc)
	if(!O) return
	animate(O, transform = CircleFXM(sc, 0), time = 0, loop = -1)
	for(var/i = 1, i <= P.tick_n, i++)
		animate(transform = CircleFXM(sc, P.tick_step * i), time = P.tick_move, easing = P.tick_ease)
		animate(transform = CircleFXM(sc, P.tick_step * i), time = P.tick_pause)

proc/CircleFXRunA(obj/O, list/steps, pd, par, looped)
	if(!O || !steps || !steps.len) return
	var/first = 1
	for(var/list/s in steps)
		var/v = round(255 * s[2] * pd, 1)
		if(first)
			first = 0
			if(par)
				if(looped) animate(O, alpha = v, time = s[1], easing = s[3], loop = -1, flags = ANIMATION_PARALLEL)
				else animate(O, alpha = v, time = s[1], easing = s[3], flags = ANIMATION_PARALLEL)
			else
				if(looped) animate(O, alpha = v, time = s[1], easing = s[3], loop = -1)
				else animate(O, alpha = v, time = s[1], easing = s[3])
		else
			animate(alpha = v, time = s[1], easing = s[3])

proc/CircleFXRunS(obj/O, list/steps, base)
	if(!O || !steps || !steps.len) return
	var/first = 1
	for(var/list/s in steps)
		if(first)
			first = 0
			animate(O, transform = CircleFXM(base * s[2], 0), time = s[1], easing = s[3])
		else
			animate(transform = CircleFXM(base * s[2], 0), time = s[1], easing = s[3])

proc/CircleFXRunAS(obj/O, list/steps, base, pd)
	if(!O || !steps || !steps.len) return
	var/first = 1
	for(var/list/s in steps)
		var/v = round(255 * s[2] * pd, 1)
		if(first)
			first = 0
			animate(O, transform = CircleFXM(base * s[3], 0), alpha = v, time = s[1], easing = s[4], loop = -1)
		else
			animate(transform = CircleFXM(base * s[3], 0), alpha = v, time = s[1], easing = s[4])

proc/CircleFXLum(turf/T)
	var/icon/I = icon(T.icon, T.icon_state, SOUTH, 1)
	if(!I) return 0
	var/w = I.Width()
	var/h = I.Height()
	var/tot = 0
	var/n = 0
	for(var/iy = 1, iy <= 4, iy++)
		for(var/ix = 1, ix <= 4, ix++)
			var/c = I.GetPixel(max(1, round((ix - 0.5) * w / 4, 1)), max(1, round((iy - 0.5) * h / 4, 1)))
			if(!c) continue
			var/list/v = rgb2num(c)
			tot += (v[1] * 0.299 + v[2] * 0.587 + v[3] * 0.114) / 255
			n++
	return n ? tot / n : 0

proc/CircleFXBright(turf/T)
	if(!T || !T.icon) return 0
	var/k = "[T.icon]"
	if(!length(k) || k == "/icon") k = "\ref[T.icon]"
	k = "[k]|[T.icon_state]"
	if(k in _circlefx_bright) return _circlefx_bright[k]
	var/b = CircleFXLum(T) >= CIRCLEFX_BRIGHT_LUM ? 1 : 0
	_circlefx_bright += k
	_circlefx_bright[k] = b
	return b

proc/CircleFXPos(list/row, k, th)
	var/a = row[1] + th + row[3] * k
	var/r = row[2] + row[4] * k
	var/cx = r * sin(a) * row[14]
	var/cy = r * cos(a) * row[15]
	var/ct = cos(row[16])
	var/st = sin(row[16])
	return list(cx * ct + cy * st + row[5] * k, -cx * st + cy * ct + row[6] * k + row[7] * k * k)

proc/CircleFXKey(list/row, k, th, face, prev)
	var/list/p = CircleFXPos(row, k, th)
	var/rot = row[12] + row[13] * k
	if(face)
		var/list/p0 = CircleFXPos(row, max(0, k - 0.02), th)
		var/list/p1 = CircleFXPos(row, min(1, k + 0.02), th)
		rot += 90 - arctan(p1[1] - p0[1], p1[2] - p0[2])
	if(!isnull(prev))
		var/d = rot - prev
		d -= 360 * round((d + 180) / 360)
		rot = prev + d
	var/matrix/M = matrix()
	M.Scale(0.5 * (row[10] + (row[11] - row[10]) * k))
	if(rot) M.Turn(rot)
	M.Translate(p[1], p[2])
	return list(M, rot)

proc/CircleFXAngle(datum/circlefx_part/P, el)
	var/F = glob.CAST_CIRCLE_FORM
	if(P.spinin)
		if(el < F) return P.spinin * (1 - sin(90 * el / F))
		return P.spin * (el - F) / 10
	if(P.spin)
		if(P.spin_hold)
			if(el < F) return 0
			return P.spin * (el - F) / 10
		return P.spin * el / 10
	if(P.tick_step)
		var/seg = P.tick_move + P.tick_pause
		var/per = P.tick_n * seg
		if(per <= 0) return 0
		var/tau = el - round(el / per) * per
		var/i = round(tau / seg)
		var/r = tau - i * seg
		if(r < P.tick_move) return P.tick_step * (i + CircleFXEase(P.tick_ease, r / P.tick_move))
		return P.tick_step * (i + 1)
	return 0

proc/CircleFXEase(e, x)
	if(x <= 0) return 0
	if(x >= 1) return 1
	var/io = e & (EASE_IN | EASE_OUT)
	var/b = e & ~(EASE_IN | EASE_OUT)
	if(b == SINE_EASING)
		if(io == EASE_OUT) return sin(90 * x)
		if(io == EASE_IN) return 1 - cos(90 * x)
		return 0.5 - 0.5 * cos(180 * x)
	if(b == QUAD_EASING)
		if(io == EASE_OUT) return 1 - (1 - x) * (1 - x)
		if(io == EASE_IN) return x * x
		if(x < 0.5) return 2 * x * x
		return 1 - ((2 - 2 * x) ** 2) / 2
	if(b == CUBIC_EASING)
		if(io == EASE_OUT) return 1 - (1 - x) ** 3
		if(io == EASE_IN) return x ** 3
		if(x < 0.5) return 4 * x ** 3
		return 1 - ((2 - 2 * x) ** 3) / 2
	return x

proc/CircleFXKind(el)
	if(el in _circlefx_kinds) return _circlefx_kinds[el]
	var/datum/circlefx_kind/K = CircleFXBuildKind(el)
	if(!K) return null
	_circlefx_kinds += el
	_circlefx_kinds[el] = K
	return K

obj/fx_rider/castcircle/proc/CircleFXStart()
	if(gone || closing) return
	var/datum/circlefx_kind/K = CircleFXKind(fx_el)
	if(!K) return
	fx_kind = K
	fx_t0 = world.time
	var/turf/T = get_turf(src)
	fx_dim = (T && CircleFXBright(T)) ? K.dimv : 1
	fx_parts = list()
	fx_lights = list()
	fx_childs = list()
	fx_pobj = list()
	for(var/datum/circlefx_part/P in K.parts)
		var/ic = P.big ? K.i2 : K.i1
		var/stn = P.st == "fhd" ? "[P.id]_form" : P.st
		var/obj/circlefx/O
		if(P.mode == 2)
			O = CircleFXPart(ic, "[stn]_base", 0, P.big)
			if(P.child)
				var/obj/circlefx/G = CircleFXPart(ic, P.st == "fhd" ? "[P.child]_form" : P.child, 1, 0)
				G.alpha = round(255 * (P.child_dim ? fx_dim : 1), 1)
				O.vis_contents += G
				fx_childs[P.id] = G
			var/obj/circlefx/L = CircleFXPart(ic, stn, 1, 0)
			O.vis_contents += L
			fx_lights[P.id] = L
		else
			O = CircleFXPart(ic, stn, P.mode == 1, P.big)
		if(P.under && !lock_layer) O.layer = MOB_LAYER - 0.1
		fx_parts[P.id] = O
		vis_contents += O
		CircleFXPartStart(P, O)
	for(var/datum/circlefx_sys/S in K.systems)
		for(var/list/row in S.rows)
			var/obj/circlefx/E
			if(S.over) E = new /obj/circlefx
			else E = new /obj/circlefx/add
			E.icon = K.ie
			E.icon_state = S.state
			E.pixel_x = 32 - K.esize / 2
			E.pixel_y = 32 - K.esize / 2
			E.alpha = 0
			vis_contents += E
			fx_pobj += E
			spawn(S.start + row[9]) CircleFXLoop(E, S, row)
	CircleFXNight(T, K.night)

obj/fx_rider/castcircle/proc/CircleFXPartStart(datum/circlefx_part/P, obj/circlefx/O)
	var/base = P.big ? 0.5 : 1
	var/pd = P.dim ? fx_dim : 1
	var/moving = 0
	if(P.spinin)
		O.transform = CircleFXM(base * P.s_init, P.spinin)
		animate(O, transform = CircleFXM(base * P.s_init, 0), time = glob.CAST_CIRCLE_FORM, easing = SINE_EASING | EASE_OUT)
		moving = 1
	else if(P.spin && !P.spin_hold)
		CircleFXSpin(O, P.spin, base * P.s_init)
		moving = 1
	else if(P.tick_step)
		CircleFXTick(O, P, base * P.s_init)
		moving = 1
	else if(P.s_init != 1 || P.s_form)
		O.transform = CircleFXM(base * P.s_init, 0)
		if(P.s_form)
			CircleFXRunS(O, P.s_form, base)
			moving = 1
	if(P.a_init >= 0)
		O.alpha = round(255 * P.a_init * pd, 1)
		if(P.a_form) CircleFXRunA(O, P.a_form, pd, moving, 0)
	else if(pd != 1)
		O.alpha = round(255 * pd, 1)

obj/fx_rider/castcircle/proc/CircleFXStates(ph)
	if(!fx_kind || !fx_parts) return
	for(var/datum/circlefx_part/P in fx_kind.parts)
		if(P.st != "fhd") continue
		var/obj/circlefx/O = fx_parts[P.id]
		if(!O) continue
		if(P.mode == 2)
			O.icon_state = "[P.id]_[ph]_base"
			var/obj/circlefx/L = fx_lights[P.id]
			if(L) L.icon_state = "[P.id]_[ph]"
			var/obj/circlefx/G = fx_childs[P.id]
			if(G) G.icon_state = "[P.child]_[ph]"
		else
			O.icon_state = "[P.id]_[ph]"

obj/fx_rider/castcircle/proc/CircleFXHold()
	if(gone || !fx_parts || !fx_kind) return
	CircleFXStates("hold")
	for(var/datum/circlefx_part/P in fx_kind.parts)
		var/obj/circlefx/O = fx_parts[P.id]
		if(!O) continue
		var/base = P.big ? 0.5 : 1
		var/pd = P.dim ? fx_dim : 1
		var/moving = P.spin || P.tick_step
		if(P.spin_hold) CircleFXSpin(O, P.spin, base * P.s_init)
		if(P.as_hold) CircleFXRunAS(O, P.as_hold, base, pd)
		else if(P.a_hold) CircleFXRunA(O, P.a_hold, pd, moving, 1)

obj/fx_rider/castcircle/proc/CircleFXClose()
	if(!fx_parts || !fx_kind) return
	CircleFXStates("dissolve")
	var/el = world.time - fx_t0
	for(var/datum/circlefx_part/P in fx_kind.parts)
		var/obj/circlefx/O = fx_parts[P.id]
		if(!O) continue
		var/base = P.big ? 0.5 : 1
		var/pd = P.dim ? fx_dim : 1
		var/moving = P.spin || P.tick_step || P.spinin
		if(P.ctf)
			var/a0 = CircleFXAngle(P, el)
			animate(O, transform = CircleFXM(base * P.s_commit, a0), time = 0)
			for(var/list/k in P.ctf)
				animate(transform = CircleFXM(base * k[3], a0 + k[2]), time = k[1])
			moving = 1
		if(P.a_close) CircleFXRunA(O, P.a_close, pd, moving, 0)
	if(fx_night) animate(fx_night, alpha = 0, time = 6.5, easing = QUAD_EASING | EASE_OUT)
	CircleFXBurst(el)

obj/fx_rider/castcircle/proc/CircleFXBurst(el)
	if(fx_pobj)
		for(var/obj/circlefx/E in fx_pobj)
			animate(E, alpha = 0, time = 0)
	for(var/datum/circlefx_sys/S in fx_kind.bursts)
		var/th = 0
		if(S.follow)
			for(var/datum/circlefx_part/P in fx_kind.parts)
				if(P.id == S.follow) th = CircleFXAngle(P, el)
		for(var/list/row in S.rows)
			if(row[8] <= 0.5) continue
			var/obj/circlefx/E
			if(S.over) E = new /obj/circlefx
			else E = new /obj/circlefx/add
			E.icon = fx_kind.ie
			E.icon_state = S.state
			E.pixel_x = 32 - fx_kind.esize / 2
			E.pixel_y = 32 - fx_kind.esize / 2
			E.alpha = 0
			vis_contents += E
			spawn(row[9]) CircleFXFly(E, S, row, th)

obj/fx_rider/castcircle/proc/CircleFXLoop(obj/circlefx/E, datum/circlefx_sys/S, list/row)
	if(gone || closing || !E) return
	var/P = row[8]
	var/list/k1 = S.keys[1]
	var/list/tf = CircleFXKey(row, k1[1], 0, S.face, null)
	animate(E, transform = tf[1], alpha = round(255 * k1[2], 1), time = 0, loop = -1)
	var/prev = tf[2]
	var/kp = k1[1]
	for(var/i = 2, i <= S.keys.len, i++)
		var/list/kk = S.keys[i]
		tf = CircleFXKey(row, kk[1], 0, S.face, prev)
		animate(transform = tf[1], alpha = round(255 * kk[2], 1), time = P * (kk[1] - kp))
		prev = tf[2]
		kp = kk[1]

obj/fx_rider/castcircle/proc/CircleFXFly(obj/circlefx/E, datum/circlefx_sys/S, list/row, th)
	if(gone || !E) return
	var/t = row[8]
	var/list/k1 = S.keys[1]
	var/list/tf = CircleFXKey(row, k1[1], th, S.face, null)
	animate(E, transform = tf[1], alpha = round(255 * k1[2], 1), time = 0)
	var/prev = tf[2]
	var/kp = k1[1]
	for(var/i = 2, i <= S.keys.len, i++)
		var/list/kk = S.keys[i]
		tf = CircleFXKey(row, kk[1], th, S.face, prev)
		animate(transform = tf[1], alpha = round(255 * kk[2], 1), time = t * (kk[1] - kp))
		prev = tf[2]
		kp = kk[1]

obj/fx_rider/castcircle/proc/CircleFXNight(turf/T, ncolor)
	if(!T || !glob || !glob.LIGHTING || !glob.DYNAMIC_LIGHTS || !_fx_glow_icon) return
	var/want = round(150 * LightRenderStrength(T) / 8, 1) * 8
	var/cap = round(LightGlowBudget(T, ncolor, want) * FxGlowCrowdScale(T.x, T.y, T.z, 1.5, null), 1)
	if(cap <= 0) return
	var/obj/circlefx/add/N = new
	N.icon = _fx_glow_icon
	N.color = ncolor
	if(glob.MULTIPLY_REVEAL)
		var/obj/fx_occlight/O = /obj/fx_occlight
		N.plane = initial(O.plane)
	N.transform = CircleFXM(1.1, 0)
	N.alpha = 0
	vis_contents += N
	fx_night = N
	animate(N, alpha = cap, time = 5)

proc/CircleFXOn(el)
	switch(el)
		if("Fire") return CIRCLEFX_FIRE_ON
		if("Water") return CIRCLEFX_WATER_ON
		if("Ice") return CIRCLEFX_ICE_ON
		if("Wind") return CIRCLEFX_WIND_ON
		if("Lightning") return CIRCLEFX_LIGHTNING_ON
		if("Earth") return CIRCLEFX_EARTH_ON
		if("Light") return CIRCLEFX_LIGHT_ON
		if("Dark") return CIRCLEFX_DARK_ON
		if("Space") return CIRCLEFX_SPACE_ON
		if("Time") return CIRCLEFX_TIME_ON
	return 0

proc/CircleFXIcon(el, which)
	switch(el)
		if("Fire") return which == 2 ? CIRCLEFX_FIRE_2X : (which == 1 ? CIRCLEFX_FIRE_1X : CIRCLEFX_FIRE_EMBER)
		if("Water") return which == 2 ? CIRCLEFX_WATER_2X : (which == 1 ? CIRCLEFX_WATER_1X : CIRCLEFX_WATER_EMBER)
		if("Ice") return which == 2 ? CIRCLEFX_ICE_2X : (which == 1 ? CIRCLEFX_ICE_1X : CIRCLEFX_ICE_EMBER)
		if("Wind") return which == 2 ? CIRCLEFX_WIND_2X : (which == 1 ? CIRCLEFX_WIND_1X : CIRCLEFX_WIND_EMBER)
		if("Lightning") return which == 2 ? CIRCLEFX_LIGHTNING_2X : (which == 1 ? CIRCLEFX_LIGHTNING_1X : CIRCLEFX_LIGHTNING_EMBER)
		if("Earth") return which == 2 ? CIRCLEFX_EARTH_2X : (which == 1 ? CIRCLEFX_EARTH_1X : CIRCLEFX_EARTH_EMBER)
		if("Light") return which == 2 ? CIRCLEFX_LIGHT_2X : (which == 1 ? CIRCLEFX_LIGHT_1X : CIRCLEFX_LIGHT_EMBER)
		if("Dark") return which == 2 ? CIRCLEFX_DARK_2X : (which == 1 ? CIRCLEFX_DARK_1X : CIRCLEFX_DARK_EMBER)
		if("Space") return which == 2 ? CIRCLEFX_SPACE_2X : (which == 1 ? CIRCLEFX_SPACE_1X : CIRCLEFX_SPACE_EMBER)
		if("Time") return which == 2 ? CIRCLEFX_TIME_2X : (which == 1 ? CIRCLEFX_TIME_1X : CIRCLEFX_TIME_EMBER)
	return null

proc/CircleFXBuildKind(el)
	switch(el)
		if("Fire") return CircleFXBuild_Fire()
		if("Water") return CircleFXBuild_Water()
		if("Ice") return CircleFXBuild_Ice()
		if("Wind") return CircleFXBuild_Wind()
		if("Lightning") return CircleFXBuild_Lightning()
		if("Earth") return CircleFXBuild_Earth()
		if("Light") return CircleFXBuild_Light()
		if("Dark") return CircleFXBuild_Dark()
		if("Space") return CircleFXBuild_Space()
		if("Time") return CircleFXBuild_Time()
	return null

