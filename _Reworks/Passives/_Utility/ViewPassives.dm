/mob/verb/View_Current_Passives()
    set category = "Other"
    set hidden = 1
    var/html = "<html><body bgcolor=#000000 text=#339999><b>Current Passives:</b><br>"
    for(var/passive in passive_handler.passives)
        if(!passive_handler.passives[passive]) continue
        if(!(passive in PassiveInfo)) continue
        html += "<b><a href=?src=\ref[src];action=GetInfo;passe=[passive]>[passive]</a> : [passive_handler.passives[passive]]</b><br>"
    html += "</body></html>"
    src<<browse(html,"window=[src]'s Passives;size=450x600")

mob/proc/OutputPassiveInfo(passive)
    var/info="<html><body bgcolor=#000000 text=#339999><br>"
    info += "<b><h3>[passive]</h3></b><hr><br> [PassiveInfo[passive]]";
    info += "</body></html>"
    src<<browse(info,"window=PassiveInfo;size=400x600")

globalTracker/var
    ANAEROBIC_FATIGUE_BASE = 0.7;
    COMBAT_SLOW_THRESHOLD = 10;
    BURNING_SHOT_TIER1_MAX = 25;
    BURNING_SHOT_TIER2_MAX = 75;
    BURNING_SHOT_TIER1_MULT = 0.25;
    BURNING_SHOT_TIER2_MULT = 0.5;
    BURNING_SHOT_TIER3_MULT = 0.75;
    ARMOR_PEEL_CAP = 0.3;
    ATTRACTING_CHARM_CD = 300;

var/list/PassiveInfo = list()

proc/buildPassiveInfoDB()
	PassiveInfo.Cut()
	PassiveInfo["AbsoluteZero"] = "While active, applying at least 1 point of Chill intensity to a target also inflicts half of that Chill amount as Shatter and half as Shock, each independently capped at 100. Does not stack."
	PassiveInfo["Air Magic Mastery"] = "Mastery over Wind magic. Increases the damage of every Wind spell you cast (value divided by [glob.CASTING_PASSIVE_DIVISOR], capped at +100%), and reduces their mana cost (capped at 95%) and cooldown (capped at 80%) by the held value as a decimal."
	PassiveInfo["Dark Magic Mastery"] = "Mastery over Dark magic. Increases the damage of every Dark spell you cast (value divided by [glob.CASTING_PASSIVE_DIVISOR], capped at +100%), and reduces their mana cost (capped at 95%) and cooldown (capped at 80%) by the held value as a decimal."
	PassiveInfo["Earth Magic Mastery"] = "Mastery over Earth magic. Increases the damage of every Earth spell you cast (value divided by [glob.CASTING_PASSIVE_DIVISOR], capped at +100%), and reduces their mana cost (capped at 95%) and cooldown (capped at 80%) by the held value as a decimal."
	PassiveInfo["Fire Magic Mastery"] = "Mastery over Fire magic. Increases the damage of every Fire spell you cast (value divided by [glob.CASTING_PASSIVE_DIVISOR], capped at +100%), and reduces their mana cost (capped at 95%) and cooldown (capped at 80%) by the held value as a decimal."
	PassiveInfo["Light Magic Mastery"] = "Mastery over Light magic. Increases the damage of every Light spell you cast (value divided by [glob.CASTING_PASSIVE_DIVISOR], capped at +100%), and reduces their mana cost (capped at 95%) and cooldown (capped at 80%) by the held value as a decimal."
	PassiveInfo["Space Magic Mastery"] = "Mastery over Space magic. Increases the damage of every Space spell you cast (value divided by [glob.CASTING_PASSIVE_DIVISOR], capped at +100%), and reduces their mana cost (capped at 95%) and cooldown (capped at 80%) by the held value as a decimal."
	PassiveInfo["Time Magic Mastery"] = "Mastery over Time magic. Increases the damage of every Time spell you cast (value divided by [glob.CASTING_PASSIVE_DIVISOR], capped at +100%), and reduces their mana cost (capped at 95%) and cooldown (capped at 80%) by the held value as a decimal."
	PassiveInfo["Water Magic Mastery"] = "Mastery over Water magic. Increases the damage of every Water spell you cast (value divided by [glob.CASTING_PASSIVE_DIVISOR], capped at +100%), and reduces their mana cost (capped at 95%) and cooldown (capped at 80%) by the held value as a decimal."
	PassiveInfo["AbyssMod"] = "Marks the holder as Evil for alignment checks and lets the holder survive entering a Depths portal instead of dying. Each point held adds value/10 to the holder's damage modifier against Good-aligned targets, reverses to a damage-reducing penalty of the same size against targets using Muken, and has a negligible effect against everyone else. Tarot Fate \"The Devil\" adds a flat +5 and \"The Lovers\" a flat +2.5 to the effective value."
	PassiveInfo["Adrenaline"] = "Once your Health drops below [glob.COMBAT_SLOW_THRESHOLD] (on a 0-100 scale), movement Delay is normally slowed by a factor of [glob.COMBAT_SLOW_THRESHOLD] divided by your Health. With Adrenaline, this slowdown inverts into a speed-up instead: between [glob.COMBAT_SLOW_THRESHOLD/2] and [glob.COMBAT_SLOW_THRESHOLD] Health, Delay is divided by that same factor and then reduced further by 1 per point held; at [glob.COMBAT_SLOW_THRESHOLD/2] Health or below, Delay is instead divided by 1 plus your held value. This effect is disabled while Undying Rage is active."
	PassiveInfo["AirBend"] = "While active, your melee strikes pull your target one tile toward you, and your autohit skills push the target one tile away on a connecting hit, both governed by a shared style-effect cooldown. Does not stack."
	PassiveInfo["Amplify"] = "Amplifies your elemental afflictions: whenever your attacks apply a debuff, each point you hold adds 0.25 to that debuff's applied intensity."
	PassiveInfo["AmuletBeaming"] = "While charging a beam, you pull your target 5 tiles toward you on each charge pulse, and while charging or firing any beam you are exempt from the movement lock that would otherwise restrict you to changing facing only. Does not stack."
	PassiveInfo["Anaerobic"] = "Reduces the movement penalty from Fatigue: your effective Fatigue multiplier becomes [glob.ANAEROBIC_FATIGUE_BASE] divided by your held value (so 1 point = 70% effect, 2 points = 35%) instead of the full penalty. It also forces the Health/Energy-based battle-power adjustment to apply to you at all times, even when you would not otherwise qualify for it."
	PassiveInfo["Anti-Scrying"] = "Reflects attempts by other players to use the Observe verb on you: unless the observer holds God's Gaze or has strictly higher God Ki than you, they take 25 damage and are informed you sensed the attempt. Does not stack."
	PassiveInfo["Antsy"] = "Adds a flat +0.1 Tension bonus to every Tension-gain event per point invested. This flat bonus is applied before the Ashen One and Heavensent multipliers, so it is scaled up alongside the rest of your Tension gain when those are active."
	PassiveInfo["ArmorAscension"] = "Adds your passive value to your equipped armor's ascension level (your armor's own item level plus this passive's value, capped at a combined total of 4). Each combined ascension level grants +5% to the armor's damage-reduction, movement-speed, and accuracy effectiveness multipliers."
	PassiveInfo["ArmorPeeling"] = "Your strikes peel through the target's armor, reducing its damage-reduction effect on your hits. The reduction scales with diminishing returns per point, up to [glob.ARMOR_PEEL_CAP*100]% at high investment."
	PassiveInfo["Aspect of Death"] = "Death-element attacks gain +3 damage modifier and the target's Pure Reduction is 25% less effective against you. Does not stack."
	PassiveInfo["AsuraStrike"] = "After a Triple Strike successfully procs, grants a chance to land a fourth strike immediately, equal to value / (value + 2) x 100%. This approaches but never reaches 100% as you invest more points, and never triggers without an active Triple Strike passive."
	PassiveInfo["Atomizer"] = "Your beams degrade the endurance of opposing projectiles and beams in clashes, scaling with passive level."
	PassiveInfo["AttackSpeed"] = "Adjusts your attack delay by 20% per point: positive points attack faster, negative points slower, via delay / (1 + points x 0.2). Clamped to a range of -4 to +8 points."
	PassiveInfo["Attracting"] = "On a successful hit, builds a stacking Attracted effect on the target equal to this passive's value, capped at 100, drawing them toward you."
	PassiveInfo["Backshot"] = "Multiplies your damage by (1 + value / 10) when you land a hit from behind the target. The back-side detection cone is widened if you also hold the Fault Finder passive."
	PassiveInfo["Backstabber"] = "Strengthens the automatic combo attack performed when warping to a target with Zanzoken."
	PassiveInfo["BackTrack"] = "Adds a flat +8 percentage points of dodge chance per point to the standard Flow-vs-Instinct dodge roll. This bonus is added independently of the Flow/Instinct calculation and is not reduced by the attacker's Instinct."
	PassiveInfo["Bear Spirit"] = "While stationary, you automatically attack and warp onto stunned targets adjacent to you. Does not stack."
	PassiveInfo["BetterAim"] = "Grants your non-homing, non-Beam projectiles a forced lock onto your current target when fired. Each point directly adds one tick to how long that forced tracking is retained before it decays."
	PassiveInfo["BeyondPurity"] = "Removes the alignment restriction on your Purity-based Holy damage bonus and wound-severity effects, which would otherwise only fully apply against Evil-aligned targets. Does not stack - with this passive, they connect fully against any target regardless of alignment."
	PassiveInfo["BladeFisting"] = "Lets your unarmed strikes satisfy skills, queues, and techniques that normally require an equipped sword. Does not stack; it has no effect while you are simultaneously wielding a second or third sword, which always overrides it off."
	PassiveInfo["BleedHit"] = "Inflicts a self-Wound equal to 15% of (damage dealt / 1.2) times your GetBleedHit() value on every hit you land. Each point adds 1 to GetBleedHit() on a 1:1 basis, and several racial high-risk-form states (Half/Full Manifestation, Shameful Display, low Gates, Kaioken, Double Helix, high Power Control) add their own extra amounts to the same total."
	PassiveInfo["BlindingVenom"] = "Landing a venom-flavored hit forces the target to lose their current target lock and breaks any grab they are holding, plus applies a flash-and-stagger effect lasting (value x 10) game points. Separately, while the target remains poisoned by you, their screen blurs at an intensity of (value x current Poison stacks / 150), fading out as the poison decays."
	PassiveInfo["BlockChance"] = "Increases your chance to block incoming damage by 1 percentage point per point invested, capped at 40 percentage points from this passive alone before any class or martial-style bonuses are added on top."
	PassiveInfo["BloodEruption"] = "Your projectile hits trigger a blood eruption around the target, scaling with passive level."
	PassiveInfo["Bloodletting"] = "Your attacks carry the Blade element and forcibly inflict Bleed on the target, ignoring normal debuff resistance checks, at an intensity equal to your passive value. Each point adds 1 to the forced Bleed intensity applied per hit."
	PassiveInfo["Blubber"] = "When you take a knockback-eligible melee hit, you have a (value x 25)% chance to knock your attacker back by knockDistance / clamp(5-value, 1, 4) tiles, and on that same roll your own knockback from the hit is reduced by 10% per point. Holding 'The Immovable Object' adds +5 to this passive's effective value for both calculations."
	PassiveInfo["BulletKill"] = "When a projectile travels directly at you while you face it head-on, it is deleted instead of striking you. Does not stack - this effect either applies or it does not, with no scaling by passive value."
	PassiveInfo["BurnHit"] = "Inflicts a self-Burn equal to 15% of (damage dealt / 1.2) times your GetBurnHit() value on every hit you land. Each point adds 1 to GetBurnHit() on a 1:1 basis; the Rekkaken buff and the Ashen One passive (via a Tension/100 multiplier) can further amplify this same total."
	PassiveInfo["Burning"] = "Grants your attacks the Fire element and adds flat Burn-debuff intensity, equal to your passive value, whenever your Fire-element debuff-proc check succeeds against a target. Each point adds 1 flat Burn intensity on a successful proc."
	PassiveInfo["BurningShot"] = "While you are self-Burned, your stat modifier increases by [glob.BURNING_SHOT_TIER1_MULT]x your passive value between 1 and [glob.BURNING_SHOT_TIER1_MAX] Burn, [glob.BURNING_SHOT_TIER2_MULT]x between [glob.BURNING_SHOT_TIER1_MAX+1] and [glob.BURNING_SHOT_TIER2_MAX] Burn, and [glob.BURNING_SHOT_TIER3_MULT]x beyond that. This passive also exempts your self-inflicted Burn from the Fire-Attunement halving, the Fire-Attunement self-burn bonus, and your own Debuff Resistance reduction, so it is not dampened by those effects."
	PassiveInfo["BurnResist"] = "Reduces the amount of Burn debuff you receive by 20% per positive point (negative points instead increase Burn taken by 20% each), applied as a multiplier to incoming Burn. Clamped to a range of -5 to +5 points."
	PassiveInfo["CalmAnger"] = "Grants all the benefits normally reserved for being in an Anger state - including Endurance boosts and God Ki doubling for Dragons - even when Anger is not actually active. Does not stack; several race/form conditions (transformed Namekian, Tarot Temperance) grant this same effect automatically."
	PassiveInfo["CashCow"] = "Increases the mana bits you gain from defeating AI enemies by 10% per point, with no cap."
	PassiveInfo["CheapShot"] = "Increases your damage against injured targets by (target's Total Injury / [glob.CHEAP_SHOT_DIVISOR]) for each point invested, plus any Mang levels you hold, which add as bonus points to the same formula."
	PassiveInfo["ChillAbsorb"] = "Redirects incoming Water-elemental damage into healing instead of harm. Every Water hit - melee, skill, projectile, or beam - heals you for 10% of the incoming hit's effective damage per point, uncapped."
	PassiveInfo["ChillImmune"] = "Grants complete immunity to the Chill (Slow) debuff - Water and Ice attacks cannot inflict Chill on you at all. Does not stack; any nonzero value fully blocks all Chill application before any resistance calculation runs."
	PassiveInfo["Chilling"] = "Grants your attacks the Water element and adds flat Chill-debuff intensity, equal to your passive value, whenever your Water-element debuff-proc check succeeds against a target. Each point adds 1 flat Chill intensity on a successful proc."
	PassiveInfo["ChillResist"] = "Reduces the amount of Chill debuff you receive by 20% per positive point (negative points instead increase Chill taken by 20% each), applied as a multiplier to incoming Chill. Clamped to a range of -5 to +5 points."
	PassiveInfo["Color of Courage"] = "Prevents you from being knocked out until your Health drops to or below the negative-health floor (-50), and changes a triggered Tenacity getup from resetting your Health to 5 into adding +5 Health instead. If you also hold Genesic Brave, King of Braves, or Saiyan Purity, it additionally scales your stat Ratio up by as much as +100% as your Health falls from 0 down to that floor. Does not stack."
	PassiveInfo["ComboMaster"] = "While your target is Stunned, Launched, or Suspended, raises the minimum combo damage-retention floor by 10 percentage points per point and reduces the per-hit combo decay rate by 0.03 per point, letting sustained combos keep dealing closer to full damage."
	PassiveInfo["Combustion"] = "Whenever an opponent's Burn debuff reaches your Combustion value, capped at 80 Burn, it detonates for damage equal to your Combustion value, increased by 50 percent if you also have Erupting Blows."
	PassiveInfo["Conductor"] = "Lowers the amount of Tension required to fill the Tension bar. Each point reduces the base 100-point threshold by 1, down to a floor of 10; a negative value instead raises the threshold above 100."
	PassiveInfo["Confusing"] = "Landing a hit applies stacking Confused buildup to the target equal to your Confusing value, capped at 100 total on the target and blocked while they are in Stasis."
	PassiveInfo["CounterMaster"] = "After a successful defensive action, converts your next basic-attack Queue into a Counter Queue that deals 0.1 bonus Counter power per point, on an internal cooldown that starts at 25 and drops by 5 per point down to a minimum of 1. Also extends the timing window for the counter to trigger, up to a hard cap."
	PassiveInfo["CrippleResist"] = "Modifies the amount of Cripple debuff you take. Each point is worth a 20 percent change to Cripple received, clamped between -5 and +5 points; positive points reduce Cripple taken, negative points increase it."
	PassiveInfo["Crippling"] = "Landing a hit applies stacking Crippled buildup to the target equal to your Crippling value, capped at 100 and reduced by the target's own Cripple Resistance, a Wind-Dragon racial resistance, and heavy Mythical stacking resistance."
	PassiveInfo["CriticalBlock"] = "Determines how effectively you mitigate damage when your Block triggers. Each point adds directly to your block potency, capped at 0.2 from this passive alone; Feather Cowl adds a further flat +0.2 while Grounded, and mastered unarmed martial styles add +0.1 plus +0.05 per Saga Level on top, both uncapped."
	PassiveInfo["CriticalChance"] = "Increases your chance to land a critical hit. Each point adds 1 percentage point of crit chance, capped at 40 percent from this passive alone (Denko Sekka, Determination Red/White, and mastered Unarmed martial styles can push the total higher, uncapped). Any nonzero value also permits autohit and spirit-attack techniques, which normally cannot crit, to roll for a critical hit or a block."
	PassiveInfo["CriticalDamage"] = "Increases the damage of your critical hits. The base bonus from this passive is capped at 0.2, a 20 percent bonus, before Denko Sekka and mastered-Unarmed-martial-style bonuses are added on top, uncapped; Demon-type characters instead apply this passive's full raw value with no cap."
	PassiveInfo["Crushing"] = "Grants your attacks the Earth element and adds flat intensity to the Shatter debuff applied when your Earth-element attack roll succeeds. Each point adds 1 flat Shatter intensity per successful proc."
	PassiveInfo["Cryokenesis"] = "While grabbing an opponent with this passive, you build up a freeze counter each tick; once it fills you become stunned for 1 plus this value in turns, take that value multiplied by a fixed damage constant, and are marked Shellshocked. Each point adds one turn of stun and one multiple of the freeze damage."
	PassiveInfo["CursedWounds"] = "Forces all combat against you to be taken seriously: any damage you take also inflicts a wound on you regardless of intent settings, and friendly-sparring protections are disabled for and against you. Does not stack."
	PassiveInfo["CyberStigma"] = "Deals bonus damage to Mechanized, Cyber-Cancel, or King of Braves opponents. The bonus scales with your CyberStigma value, the target's own Mechanized/Cyber-Cancel tier, and how far the target's mana ratio sits from a 100 percent baseline, divided by 33."
	PassiveInfo["DarknessFlame"] = "Whenever you deal Burn damage to an opponent, that same hit also inflicts Poison equal to the Burn amount dealt, plus a flat bonus of 0.125 Poison per point of DarknessFlame."
	PassiveInfo["DeathField"] = "Enemies who strike you unarmed or with a sword take self-inflicted wound damage based on your DeathField value, divided by the raw damage of their own hit - so lighter hits reflect proportionally more wound than heavy hits. The total is further boosted by Kamui lock state, a Beastkin Heart-of-the-Beast bonus, Determination(Green/White), and Lunatic Mode."
	PassiveInfo["DebuffDurationReduction"] = "Your own debuff stacks decay faster: whenever your total DebuffDurationReduction is positive, your base decay rate is multiplied by 1 plus that total. A total of zero or below has no effect."
	PassiveInfo["DebuffResistance"] = "Hardens you against debuffs: your debuff-stack decay rate is multiplied by 1 plus one quarter of your DebuffResistance total, and certain debuffs apply to you at a reduced rate. For Stasis specifically, a total of 1.0 or higher divides the duration you receive, capped at dividing by 1.5 for a maximum 33 percent reduction; a total below 1.0 instead lengthens the Stasis you receive."
	PassiveInfo["DebuffReversal"] = "Reverses several debuffs into bonuses: Slow, Shock, and Shatter increase your stat mods instead of lowering them, and Cripple speeds you up instead of slowing you. While you have Burn or Poison stacked, landing a counter-hit also inflicts extra Burn or Poison on your attacker proportional to your own stack. Also granted implicitly if your elemental defense is Ultima; overrides Debuff Resistance while active."
	PassiveInfo["Deflection"] = "Grants a chance to deflect deflectable projectiles and reduces the damage of deflectable attacks that land, both scaling per point. Damage reduction is floored at 25-30% of the original hit."
	PassiveInfo["Deicide"] = "Deals bonus damage to opponents with God Ki, equal to your Deicide value multiplied by the target's own God Ki value, divided by a fixed divisor. While held, you permanently lose access to your own God Ki."
	PassiveInfo["DemonicInfusion"] = "Infernal power rides your strikes: your autohit techniques become eligible to critically hit, and landing a critical hit automatically unleashes a Hellfire Rain barrage. Does not stack."
	PassiveInfo["DenkoSekka"] = "Grants +1 maximum Zanzoken charge per level, clamped between 0 and 10. After performing a Zanzoken, your next attack also gains +5 CriticalChance per level."
	PassiveInfo["DisableGodKi"] = "Disables your access to God Ki entirely while active. If you also have Hidden Potential, this reduces its God Ki copy multiplier to 0.25 - the same reduction Endless Nine causes on its own, without needing both together. Does not stack."
	PassiveInfo["Disarm"] = "Increases both how often you disarm sword- or staff-wielding opponents and how long they stay disarmed. Landing enough qualifying hits triggers the disarm; opponents without a sword or staff equipped instead take a flat 10 Crippled. Works together with the separate Disarmed status it applies to the target."
	PassiveInfo["Disorienting"] = "Each point grants a flat +25% chance on a qualifying hit to inflict Confusing on your target (effectively guaranteed at 4+ points), with the Confusing magnitude equal to the triggering hit's value (clamped 1-10) x1.25."
	PassiveInfo["DoubleStrike"] = "Grants a chance to strike again on basic melee attacks (not combo-queue attacks): chance% = value/(value+4) x100, approaching but never reaching 100% (e.g. 4 points = 50%, 12 points = 75%)."
	PassiveInfo["Dragon Spirit"] = "Multiplies your beam charge rate by 5, stacking multiplicatively with Ki Control Mastery and Quick Cast charge bonuses; does not affect the beam's eventual damage. Does not stack."
	PassiveInfo["DrainlessMana"] = "Makes Mana always appear sufficient to spend and voids ordinary Mana loss while active - effectively free spellcasting. Certain forced mana-upkeep effects (e.g. some buff drains) still apply. Does not stack."
	PassiveInfo["DualCast"] = "Doubles the number of blasts or rounds fired by your magic-reliant Projectile and AutoHit techniques. Does not stack."
	PassiveInfo["Duelist"] = "Increases your damage against your selected Target by one bonus step per point."
	PassiveInfo["EarthHerald"] = "Detonates a target's Shatter stacks once they reach 100/value (higher passive values trigger the burst at a lower Shatter total), dealing burst earth damage and cutting the target's Defense multiplier by 10% for roughly 10 seconds. Limited by a shared glob.IMPLODE_CD (150-tick) detonation cooldown. Does not stack."
	PassiveInfo["EndlessNine"] = "Negates a portion of the God Ki damage bonus your attacker gains against you, scaling from 1x your value at full health up to 8x as your health drops toward 0 (clamp of 100/(Health+1) between 1 and 8), capped at the attacker's own God Ki value. Also disables your own God Ki entirely and grants immunity to Destroy-type effects."
	PassiveInfo["EnergyGeneration"] = "Restores Energy and recovers Fatigue when you land attacks, scaling per point."
	PassiveInfo["EnergyLeak"] = "Reduces your energy regeneration: once your combined EnergyLeak total exceeds 1, all energy you heal from any source is cut in half. Also triggers implicitly during mid-mastery transformations (10-75% mastery without Mystic), at Double Helix 1+, or during incomplete Manifestation stages - unless Pride is active and your Health is 90 or above, which grants full immunity."
	PassiveInfo["EnergySteal"] = "Restores Energy to you equal to a percentage of the damage you deal, draining the same amount of Energy from your target: 1% per point, plus a flat +5% if Determination(Black) is active."
	PassiveInfo["EntanglingRoots"] = "Melee hits have a chance, on a shared glob.STYLE_EFFECT_CD (400-tick) style-effect cooldown, to root your target in place for glob.ROOTS_DURATION (2) points. Does not stack."
	PassiveInfo["Entropic"] = "Increases how quickly your own equipment loses durability when it is struck in combat: durability loss is multiplied by (1 + value)."
	PassiveInfo["Erosion"] = "On each hit, gradually erodes up to eight of your target's stat multipliers (Power, Strength, Endurance, Speed, Force, Offense, Defense, Recovery) toward a cap of their own multiplier x value/4, accumulating (cap/45) x damage dealt per hit toward that cap."
	PassiveInfo["EvilResist"] = "Reduces the damage you take from Evil-aligned attackers by 10% per point (tick), up to a maximum of 5 points (50% total reduction)."
	PassiveInfo["Extend"] = "Increases both the range and the effect/hitbox size of your sword-reliant AutoHit techniques by 1 tile per point."
	PassiveInfo["Fa Jin"] = "While your Fa Jin cooldown is ready, empowers your queued techniques: adds value x1.75 to their damage multiplier and value x3 to their knockback, and shows a ready indicator. Using it resets an internal cooldown of 250 points, reduced by 25 points per point."
	PassiveInfo["Familiar"] = "Summons a familiar that automatically hurls your elemental aura's assigned attack at your Target on a 500-tick cooldown; each point beyond the first reduces that cooldown by 30 points."
	PassiveInfo["FatigueImmune"] = "You cannot gain Fatigue while this passive or your Infinity Module is active. Does not stack."
	PassiveInfo["FavoredPrey"] = "Selects which category of opponent (Mortal, Transformations, Gender, Secret, a specific player's ckey, All, Depths, or Beyond) your separate Slayer damage bonus applies to; has no effect without that paired bonus. The Transformations category guarantees at least your Ascensions-Acquired amount of bonus; the Secret category quarters the bonus; the Gender category always reduces the bonus to zero."
	PassiveInfo["FireAbsorb"] = "Burn debuff damage is completely negated against you (reduced to 0). Does not stack. (Heat of Passion grants the same negation automatically once your Health drops to 15 or below.)"
	PassiveInfo["Flicker"] = "Speeds up Zanzoken (afterimage-dash) charge regeneration. Your combined Flicker total (own value plus several other sources) divided by 5, plus 1, gives the regen multiplier, clamped between 1x and 2x normal speed."
	PassiveInfo["Flow"] = "Grants a chance to completely avoid melee blows: below a soft cap of 5 raw points, each point of Flow (minus the attacker's own, similarly capped, Instinct) is worth 5% dodge chance; points beyond 5 give diminishing returns via a soft-cap curve. A separate BackTrack passive adds a flat +8% per point on top."
	PassiveInfo["FluidForm"] = "Claws an attacker's accuracy bonus back down toward (but never below) their unmodified baseline when they have an accuracy buff active against you; also helps you recover your own reduced accuracy when you are the one attacking. Does not push an attacker's accuracy below their normal hit chance."
	PassiveInfo["Flying Thunder God"] = "When your Iaido gauge is full and you are within warp-strike range of your Target, your next attack instead triggers the Flying Thunder God instant relocation strike and resets the Iaido gauge. Does not stack."
	PassiveInfo["Forever After"] = "Adds the Love element to all of your attacks. Does not stack."
	PassiveInfo["Freezing"] = "Your elemental attacks apply extra Chill (Slow) to the target, adding your Freezing value directly (1:1) on top of the base Chill amount; also guarantees a debuff application on hits that would otherwise roll to fail."
	PassiveInfo["Fury"] = "Dealing damage gives a 50% x Fury chance to gain 1 + Fury/4 Fury stacks (max 32, or 50 with Relentlessness); each stack raises your Speed multiplier toward a ceiling of +0.125 per point of Fury at full stacks, doubled while Angered and increased 25% by Relentlessness. An enemy's Acupuncture strips your stacks instead of letting you gain them on that hit."
	PassiveInfo["GiantForm"] = "Grants Giant Form: a flat +1.25 to your own knockback-dealt modifier, a flat +0.15 to your knockback resistance when defending, and a giant-size visual. Does not stack."
	PassiveInfo["GodCloth"] = "While your target is healthier than you, your God Ki total is multiplied by up to 4x (health ratio clamped 1-4). Does not stack."
	PassiveInfo["GodKi"] = "Your measure of divinity. Each point adds 10 (x GODKI_DIFF_MULT, 1) to your outgoing damage bonus against a defending target with less God Ki, capped at a total of 1.5, and by the same rate reduces damage you take from higher-GodKi attackers if your own total is higher. Also grants scrying superiority and unlocks God-Ki-gated content. Deicide, EndlessNine, Null, or Longing on the holder zero the total."
	PassiveInfo["Godspeed"] = "Increases your movement speed with diminishing returns: your speed multiplier is 0.4 x the square root of your Godspeed value (AI companions use a separate 0.5x formula). At 2 or more effective points you gain the same fast-traversal eligibility as Flying or Water Walk, and at 6 or more you become immune to Slow effects."
	PassiveInfo["GoodResist"] = "Reduces the bonus damage Good-aligned attackers deal to you by 10% per point, up to a maximum of 5 points (50% total reduction)."
	PassiveInfo["Grippy"] = "Makes your grabs unavoidable and increases the target's difficulty of escaping them: each point adds 0.25 x value to the grab-escape resistance denominator."
	PassiveInfo["Gum Gum"] = "Extends the reach and area of Unarmed-only techniques. Each point adds +1 tile to both their Distance and Size."
	PassiveInfo["Gun Kata"] = "While your attack qualifies as a Special Strike (wielding a Staff, holding Determination Yellow/White, or via a matching Eldritch secret), your normal attacks additionally fire a Gun Kata Shot projectile. Does not stack."
	PassiveInfo["Half-Sword"] = "While wielding a sword, reduces an armored target's effective armor value by 1 per point (letting more of your attack bypass their mitigation), or adds 10% bonus damage per point against an unarmored target. Wielding a Heavy-class two-handed sword adds +1 to this total."
	PassiveInfo["Harden"] = "Being hit builds Harden stacks (up to 32, or 100 with Relentlessness) with a 50% x value chance per hit and a gain of 1 + value/2 stacks per proc. At full stacks, your Endurance multiplier rises toward a ceiling of +0.1 per point of Harden (value clamped 0-5). An attacker's Acupuncture strips your stacks instead of letting you build them on that hit."
	PassiveInfo["HardStyle"] = "Increases your damage against a target based on their accumulated Wounds: adds (target Wounds / 20) / 3 per point of HardStyle to your damage modifier. Also inflicts bonus Wounds on each hit equal to 10% of value x damage dealt, clamped between 0.01% and 75% of that hit's damage."
	PassiveInfo["Heavensent"] = "Increases Tension gained from every Tension-gain event by 10% per point, multiplicative and uncapped. During the world's Sun event, Heavensent (along with Rank-Down Protection and Angels) is NOT immune - it routes you into the Sun-Seared effect: 100 Burn plus DisableGodKi and Silenced for 60 seconds, a harsher outcome than the 50-Burn Sun-Stricken effect applied to Evil-aligned mobs."
	PassiveInfo["HeavyHitter"] = "Increases the knockback of your attacks: each point adds 1 to your knockback-multiplier sum (halved by a global divisor, capped at a multiplier of 2). Any HeavyHitter also forces your knockback through a Guarding target's normal knockback immunity."
	PassiveInfo["HellPower"] = "Scales overall power based on missing health once at least 1 point is held, capped at an internal value of 2. The stat multiplier is 1 + the square root of (missing health % x internal value / 1.5). Demon-race, Demonic Oozaru, or fully-unlocked-Celestial mobs instead get 1.5x that internal value (undivided) plus a Potential/100 bonus."
	PassiveInfo["HellRisen"] = "While Dominating an opponent with less health than you, adds 2 x value to Pursuer and Instinct (uncapped) and 2 x value to Flicker (capped at 2); at 0.75+ points it also adds value/4 to Mortal Strike and value x4 to Technique Mastery. Landing a hit on a Stunned or Launched Dominated target additionally applies a buff (scaling off value x4) granting free combo-chaining plus bonuses to PureDamage, Shattering, and Steady."
	PassiveInfo["Hit Scan"] = "Extends your normal-attack reach in a straight line by one tile per point. Hitting a target beyond your normal adjacent reach through this extension adds a flat 5-tick delay penalty to your next attack."
	PassiveInfo["HolyMod"] = "Aligns you with Good (unless you also hold AbyssMod) and increases your damage against Evil-aligned targets by your HolyMod value, plus a Tarot Fate bonus (+2.5 for The Lovers, +5 for The Hierophant)."
	PassiveInfo["HotHundred"] = "Lets your basic light attacks auto-chain as though a combo were already queued (shared with Speed Force at 2+) and raises your combo damage-proration floor from 30% to 50%, so extended combos retain more damage. Does not stack."
	PassiveInfo["Hustle"] = "Your techniques recharge 25% faster. Has no effect if you have Technique Mastery. Does not stack."
	PassiveInfo["Iaijutsu"] = "Lets you slip sword-based attacks: when hit by a sword-wielding attacker, you have an 80 x value / (value + 2) percent chance (glob.IAI_CHANCE_CAP / glob.IAI_CHANCE_CURVE - diminishing, never reaches 100%) to halve the incoming damage (glob.IAI_DR_MULT)."
	PassiveInfo["IceAge"] = "Whenever an opponent's Slow debuff reaches your IceAge value, it detonates into a Chill implosion, with magnitude equal to your IceAge value. Each point raises both the trigger threshold and the detonation's magnitude 1:1, with no upper cap."
	PassiveInfo["Inevitable"] = "Trades attack speed for power on unarmed and sword techniques: each point adds +1 flat delay to your own attack speed (capped at a delay of 20) and +5 to the true-damage multiplier for unarmed or sword strikes only."
	PassiveInfo["InjuryImmune"] = "You cannot gain wounds and wound-scaling benefits no longer apply to you, unless neutralized by Katen Kyokotsu Bankai's Tragedy effect on you or your current target. Does not stack."
	PassiveInfo["Instinct"] = "Sharpens your attacks against evasive defenders: your Instinct total (raw passive value plus a quarter of your base Offense and other bonuses) is subtracted 1-for-1 from the target's Flow, directly reducing their percent chance to dodge (at a base rate of 5% per net point of Flow)."
	PassiveInfo["Interception"] = "Grants a 10% x value chance to intercept an enemy's queued (non-Finisher) technique before it lands: their queue is cleared, their attack's damage is negated, and you strike back instead."
	PassiveInfo["Juggernaut"] = "Hardens you against crowd control. Each point divides incoming stun duration by an additional 0.25 (applied as amount/(1+mod)), extends your post-stun immunity window by the same factor, adds 5% knockback resistance (capped), and adds 25% to the cooldown before you can be launched again."
	PassiveInfo["KiControl"] = "Counts as having Ki Control for any system that checks HasKiControl() - DoubleHelix also satisfies this check on its own. Does not stack."
	PassiveInfo["KiControlMastery"] = "Improves Ki efficiency broadly: divides all Energy-loss and Fatigue-gain amounts by (1 + value), increases your Power-Up charge-rate gain by a multiplier of (1 + value) - or (2 + value) once your active transformation reaches 100% mastery - and reduces the charge time of chargeable skills and beams by 10% per point."
	PassiveInfo["LifeGeneration"] = "Being struck heals your Health by (0.75 + 0.25 per point) divided by LIFE_GEN_DIVISOR, multiplied by the damage taken; once you are at full effective health, the same rate also heals your Wounds (scaled further by WOUND_RECOVERY_REDUCTION)."
	PassiveInfo["LifeSteal"] = "Heals you for a portion of the damage you deal - each point is one percent of damage returned as health. The more life you have already stolen, the weaker further stealing becomes, until it fully saturates."
	PassiveInfo["LikeWater"] = "Adaptive combat flow: when your opponent's raw accuracy investment (Instinct) has caught up to your current dodge stat (Flow), you gain half your LikeWater value added to Flow; symmetrically, when their raw Flow has caught up to your Instinct, you gain half your value added to Instinct."
	PassiveInfo["LingeringPoison"] = "Your poisonous strikes can leave lingering poison clouds. Each point adds to the on-hit spawn chance, the cloud's base potency, and its lifetime, while narrowing how randomly the cloud is placed near you."
	PassiveInfo["MagicSword"] = "Your equipped sword counts as a staff for spell-casting and magic-focus checks. Does not stack."
	PassiveInfo["MaimMastery"] = "Negates the power-ratio penalty you would otherwise suffer from your own outstanding maims (or Changeling race also qualifies) - it defends you against being maimed rather than improving your ability to maim opponents. Does not stack."
	PassiveInfo["ManaGeneration"] = "Restores Mana when you land attacks, scaling per point."
	PassiveInfo["ManaSteal"] = "Your strikes siphon Mana: on every hit, you recover Mana equal to 1% of the damage dealt per point, and the target loses the same amount."
	PassiveInfo["MartialMagic"] = "You can cast Magic without needing a Magic Style or a spell focus - it bypasses the same restriction checks that a mastered Magic Style or LimitlessMagic would. Does not stack."
	PassiveInfo["MeleeResist"] = "Reduces the damage you take from melee attacks, including basic and queued attacks. Each point is worth 20%; negative values increase melee damage taken."
	PassiveInfo["MeltyBlood"] = "Your blood scalds: enemies striking you are burned, and bleed effects on you are amplified."
	PassiveInfo["Miracle"] = "Below 30% health: (100-Health) x 0.6 percent chance to reduce incoming damage to zero. Does not stack."
	PassiveInfo["Momentum"] = "Dealing damage builds Momentum stacks (up to 32, or 50 with Relentlessness) that increase your Strength. Passive level (capped at 2 effective points for the chance and per-hit gain-rate) raises the chance of gaining a stack per hit and how many stacks you gain; the Strength bonus itself scales with your raw passive investment and is not capped at 2."
	PassiveInfo["MonkeyKing"] = "Your melee strikes can summon a monkey soldier to fight beside you. Each point adds 25 percentage points to the on-hit summon chance and raises the summoned soldier's tier."
	PassiveInfo["Mortal Will"] = "Every sixth melee hit automatically hurls a Comet Spear at your target. Does not stack."
	PassiveInfo["Motivation"] = "You build Tension faster when struck, scaling per point."
	PassiveInfo["MovingCharge"] = "You can move while charging techniques. Does not stack."
	PassiveInfo["Muscle Power"] = "Increases the damage of your grapple techniques. Each point adds 25% to the grapple damage multiplier."
	PassiveInfo["Musoken"] = "Sword-intent nullifier: if your opponent holds Musoken and you have a sword equipped, your Style Offense bonus is zeroed - or only halved instead if you also hold Musoken yourself. Does not stack."
	PassiveInfo["NoDodge"] = "Removes access to your active dodge and reactive-counter mechanics, including guaranteed dodges, Flow counters, and afterimage-strike counters. Does not stack."
	PassiveInfo["NoWhiff"] = "While active, your normal melee, autohit, and grapple attacks cannot whiff (miss). Does not stack."
	PassiveInfo["Null"] = "Total divinity null: you ignore God Ki damage bonuses entirely and count as a Null target. Does not stack."
	PassiveInfo["Paralyzing"] = "Your attacks apply additional Shock to the target, scaling per point."
	PassiveInfo["Parry"] = "Grants a chance to parry sword-based attacks with an instant counterattack: proc chance is 80 x value / (value + 2) percent (glob.PARRY_CHANCE_CAP / glob.PARRY_CHANCE_CURVE - diminishing, never reaches 100%), and the riposte hits for 0.3 x (Parry value + sword bonus) damage-multiplier (glob.PARRY_BASE_DMG), chaining up to 5 times per exchange (glob.MAX_CHAIN_PARRY)."
	PassiveInfo["Persistence"] = "When you take damage, Persistence gives a chance to convert it into wounds instead of health loss, with the odds and strength scaling with your Persistence value (clamped between 0.1 and 8). This scales correctly off your own value for self-inflicted damage and damage-over-time points, but in direct hits from another combatant the scaling reads the attacker's Persistence value instead of yours (see flags)."
	PassiveInfo["Piercing"] = "When your attack lands on a target's shields (shields) without breaking it, this passive lets a fraction of the otherwise fully-blocked damage continue through to the target's next defense layer instead of being entirely absorbed. It has no effect on general armor (BioArmor) or against targets without an active Vaizard shield."
	PassiveInfo["PilotingProwess"] = "Improves your mech piloting, scaling with Intelligence and passive level."
	PassiveInfo["Poisoning"] = "Grants your attacks the Poison element and adds flat bonus intensity to the Poison debuff you apply on Poison-element hits, alongside Toxic's own bonus, subject to the normal debuff proc-chance roll."
	PassiveInfo["PureDamage"] = "Increases all damage you deal by [glob.PURE_MODIFIER*10]% per point."
	PassiveInfo["PureReduction"] = "Reduces all damage you take by [glob.PURE_MODIFIER*10]% per point. When your combined reduction outweighs the attacker's bonuses, the remainder is applied as a divisor instead, so deep stacking has diminishing returns and can never reach full immunity."
	PassiveInfo["Purity"] = "While active, your Holy-aligned attacks and effects only land on targets flagged Evil; they are blocked entirely against non-Evil targets unless you also have BeyondPurity, which extends the exception to Good targets as well. Also softens wound and gore display toward non-Evil targets. Does not stack."
	PassiveInfo["Pursuer"] = "Reduces Dragon Dash's cooldown. Each point removes 10 percent of the base cooldown additively, capped at a 90 percent reduction once the combined total from all sources (including saga and transformation bonuses) reaches 9."
	PassiveInfo["PUSpike"] = "Activating a buff spikes your Power Up. Each point (percent-basis) contributes 1 percentage point to the aggregate Power-Up spike total, alongside Mang (+30/level), Shirayuki-while-slowed (+1/point of Slow), Imaginary class bonuses (+50 flat while ActiveBuff/SpecialBuff), RedPUSpike (+200/point), and Overdrive (+200 flat)."
	PassiveInfo["QuickCast"] = "Increases beam and spell charge/cast speed: your charge-speed multiplier is multiplied by (QuickCast value + 1). For example, QuickCast=1 doubles the multiplier, QuickCast=2 triples it. Stacks additively before that multiplication, no cap."
	PassiveInfo["Rage"] = "A berserker stat that only activates as your Health drops. Below 50 percent Health it both boosts your effective PureDamage and weakens your effective PureReduction by clamp(missingHealth x Rage / glob.RAGE_DIVISOR, 0-0.1, glob.MAX_RAGEPUREDAMAGE). Below 75 percent Health it grants a flat 5 x Rage bonus to LifeSteal, and below 25 percent Health it guarantees the Hustling state outright."
	PassiveInfo["Rank-Down Protection"] = "Grants protection from administrative rank and stat edits and from admin-forced knockouts. Does not stack."
	PassiveInfo["RefreshingBlows"] = "Your blows refresh your allies: each swing cleanses debuff stacks from party members near you, with range and cleansing strength scaling per point."
	PassiveInfo["Relentlessness"] = "Amplifies the Fury/Harden ramp-passive family: each Fury stack is worth 25 percent more, and Fury's cap rises to 50 (from a lower base) while Harden's cap rises to 100 (from a lower base). It also accelerates the natural per-tick decay of Fury and Momentum stacks alike, subtracting an extra fraction of the current stack (stack/50 for Fury, stack/40 for Momentum) on top of the normal decay each tick. Does not stack."
	PassiveInfo["Reversal"] = "Grants a diminishing-returns chance to reflect an incoming autohit back at its attacker. Proc chance equals value / (value + 2) x 100 percent - for example 1.0 gives about 33%, 3.0 gives 60% - and never reaches 100%. The reflected hit must still pass an accuracy check against the original attacker."
	PassiveInfo["Ripple"] = "Ripple is your Hamon technique resource. Its effective value used in damage calculations is multiplied by 0.75 for each of Slow, Shocked, or Cyber-Cancelled you are affected by (compounding independently), or by 1.5 while Swimming, and scales a RipplePower multiplier applied to Autohit, Projectile, and Beam Clash damage."
	PassiveInfo["Rusting"] = "Corrodes technological enhancement: while the target is poisoned, the bonuses from their stat Enhancements are reduced, scaling with your passive level and their Poison."
	PassiveInfo["Scoop"] = "Increases your grab-lunge range. Each point adds one extra tile to the dash distance used when lunging to grab a distant target (base distance is 2 tiles)."
	PassiveInfo["Scorching"] = "Grants your attacks the Fire element and adds flat bonus intensity to the Burn debuff you apply. Fire-element hits from you automatically force-apply the debuff regardless of the normal proc-chance roll, and each point of Scorching adds 1 flat intensity to the resulting Burn stack."
	PassiveInfo["SecondWind"] = "Grants a last-stand recovery when you would be knocked out, with the exact behavior set by the granting source (Hope, Echo, Unstoppable, or Comeback variants differ in how often they can trigger and how much Health they restore). Does not stack."
	PassiveInfo["Serrated"] = "Your sword strikes have a [glob.SERRATEDCHANCE]% chance per point to fester the wound, applying the Festered Wound debuff."
	PassiveInfo["Shattering"] = "Grants your attacks the Earth element and adds flat bonus intensity to the Shatter debuff you apply. Earth-element hits from you automatically force-apply the debuff regardless of the normal proc-chance roll, and each point of Shattering adds 1 flat intensity to the resulting Shatter stack."
	PassiveInfo["ShatterResist"] = "Modifies the amount of Shatter debuff you receive. Each point is worth 20 percent, and the passive is clamped between -5 and +5 points."
	PassiveInfo["ShearImmunity"] = "Grants full immunity to the Shear debuff: incoming Shear accumulation is negated entirely and any existing Sheared stacks are cleared. Does not stack."
	PassiveInfo["Shearing"] = "On a successful hit, applies Shearing intensity equal to your passive value to the target's Sheared debuff meter, reduced by the target's shear resistance and by diminishing stacking resistance, up to a cap of 100. Fully blocked by ShearImmunity."
	PassiveInfo["ShearResist"] = "Modifies the amount of Shear debuff you receive. Each point is worth 20 percent, and the passive is clamped between -5 and +5 points."
	PassiveInfo["ShockAbsorb"] = "Heals you instead of damaging you when struck by a Lightning-elemental attack. Each point heals 10% of the incoming damage, on every attack type."
	PassiveInfo["Shocking"] = "Grants your attacks the Wind element and adds flat bonus intensity to the Shock debuff you inflict on Wind-element hits. Unlike Scorching or Shattering, Wind-element hits still roll the normal elemental proc chance rather than auto-applying; each point adds 1 flat intensity (combined with Paralyzing's own bonus) to the resulting Shock debuff."
	PassiveInfo["ShockResist"] = "Reduces the intensity of the Shock debuff you receive, or increases it if negative. Each point is worth 20%, clamped to a total of -5 to +5 points - a 0% to 200% range of normal Shock intensity taken."
	PassiveInfo["ShonenPower"] = "While your Health is at or below 25%, boosts your overall Power by roughly 15% per point (modulated by your current Fatigue and Injury), and the first time your Health crosses below 25% grants a one-time Vaizard Health shield sized by your Injury and Fatigue divided by (10 minus your ShonenPower, or 28 minus it if you hold Unstoppable), clamped between 1 and 50."
	PassiveInfo["Siphon"] = "Heals Energy when you are struck by a ForDmg-flagged AutoHit, a ForRate-flagged Projectile, or (while using Spirit Hand/Sword/Hybrid Strike/Spirit Strike) a melee hit. Each point converts 10% of the relevant hit's damage into Energy, further scaled by the attacking skill's own force-conversion rate on AutoHit/Projectile hits; in melee, each point additionally adds 10% chance per hit for the heal to trigger, and the attacker's own damage is always chipped by 15% of the heal amount."
	PassiveInfo["Skimming"] = "Sets a minimum movement-speed floor that only raises your speed when your other stats would put you below it, grants immunity to water/deluge hazards, and automatically triggers a bump-attack dealing 15% melee damage when you collide with an enemy while active."
	PassiveInfo["SlayerMod"] = "Grants bonus (or, if negative, penalty) damage against your chosen Favored Prey category. The total is clamped between -10 and 10 after modifiers (x1.5 on Slayer-specialist sagas, reduced by the target's Xenobiology unless prey is 'All', negated if the target uses Muken), then halved when applied to your final damage. Requires selecting a Favored Prey to have any effect."
	PassiveInfo["Sniper"] = "Increases melee normal-attack damage based on distance to the target. Each point adds 1% damage per tile of separation, uncapped, and only applies when the target has a valid location and the distance is greater than zero."
	PassiveInfo["SoftStyle"] = "Deals bonus damage scaling with the target's current Fatigue, adding (target's Total Fatigue / 20) x (SoftStyle / 2) to your damage. Also inflicts extra Fatigue on the target with every hit, equal to the hit's value times a rate of 0.2 x SoftStyle, clamped between 0.01% and 50% of that hit's value."
	PassiveInfo["SoulFire"] = "On landing a hit while Fighting Seriously, always drains the target's Mana by 40% of the damage x SoulFire and inflicts bonus Fatigue equal to 10% of the damage x SoulFire. Additionally shrinks the target's Mana Capacity by that same 10% amount, but only against targets that are not Mechanized or Cyber-Cancelled."
	PassiveInfo["SoulSteal"] = "Converts a portion of the damage you deal into shields, a temporary shield resource. Each hit grants damage x SoulSteal, and your shields is capped at 15 x SoulSteal any time it would exceed that after the grant."
	PassiveInfo["SoulTug"] = "Your strikes tug at artificial souls, confusing mechanical targets."
	PassiveInfo["SpaceWalk"] = "Grants immunity to Oxygen drain on space/star tiles and to the Oxygen/Health drain of water, Deluged, and Ichor tiles (equivalent to Fishman for those hazards). Does not stack, and does not affect static-tile hazards or lava."
	PassiveInfo["Speed Force"] = "Grants a speed-focused combat archetype. Overrides your attack-delay formula to divide by (Speed x 4) with the floor lowered to 0.33, and reduces your true-damage multiplier by 2 x (Speed Force / EffectiveSF), where EffectiveSF is 2 if you hold the Heavenly Restriction 'Speed' improvement, else 1. At 2 or more points, light-attack damage instead scales as 0.25 x Speed Force per point and gains a proration-floor bonus; at 3 or more points, grants a warp-strike reposition of 1.5 tiles per point."
	PassiveInfo["SpellRange"] = "Increases the maximum range of elemental spell projectiles you cast. Each point adds 1 tile of range."
	PassiveInfo["SpiralPowerUnlocked"] = "Spiral Energy: unlocks early ascensions equal to the value and empowers spiral-driven abilities. Story progression caps at 7."
	PassiveInfo["SpiritPower"] = "Grants energy-signature omniscience for sensing/telepathy features, exempts you from a Death-Location Sense lock, and grants a mild-divinity bonus at low health: while your Health is at or below (30 + Total Injury) x SpiritPower, gain a combat-stat bonus of 0.25 x SpiritPower (quartered for god-ki saints). Per the in-game description it also marks you as Good and boosts Holy/Abyss Mod effectiveness."
	PassiveInfo["SpiritualDamage"] = "Adds directly to your damage multiplier on attacks flagged as spiritual-type. Each point adds 1 point to that multiplier."
	PassiveInfo["StaffAscension"] = "Adds to your equipped staff's effective Ascension tier, boosting staff Damage (capped at a combined tier of 6) and staff Drain-efficiency and Accuracy (each capped at a combined tier of 4). Each of the three bonuses is worth 5% per combined Ascension tier."
	PassiveInfo["StaticWalk"] = "Prevents the passive Health drain applied on Static and Dirt99 hazard tiles, and grants immunity to being Frozen by the Nox 'Stop Time' ultimate skill. Does not stack, and does not affect Oxygen loss (that is SpaceWalk's effect)."
	PassiveInfo["StunningStrike"] = "Gives your hits a chance to Stun a not-already-Stunned target for a flat 3 points, and adds directly to the stun duration of your skills that already inflict a Stun. Each point adds 10% to the proc-chance (clamped between 10% and 70% overall) and +1 to the Stunner value of qualifying skills."
	PassiveInfo["Sunyata"] = "Emptiness technique: while your attacker has a combo attack queued, grants a chance to nullify their queued technique outright. Each point adds 5% chance."
	PassiveInfo["SuperCharge"] = "Reduces the opponent's beam endurance drain rate in a clash by 10% per point (clamped to a maximum 100% reduction), but only while off cooldown - the effect can trigger at most once per 500 world-time points, reset each time it fires from a beam launch."
	PassiveInfo["SuperDash"] = "Improves your dash skills: the combined SuperDash total (your passive value plus bonuses from high Sense unlocks and the Infinity Module) increases dash Distance by 15 to 20 per point depending on the dash used, reduces dash Delay to 0.5 divided by that total, and adds (total/4) accuracy to the dash's follow-up strike. The usable total is capped at 2, so higher investment beyond that yields no further benefit."
	PassiveInfo["SweepingStrike"] = "Turns your normal attack and queued-attack range from a frontal strike into an arc centered on you. The arc radius equals the higher of your SweepingStrike and GiantSwings values (minimum 1), with an extra +1 radius if you hold both."
	PassiveInfo["Sword Master"] = "Lets you wield and continue using broken swords, and waives the sword requirement for styles/buffs that would otherwise cancel when your sword shatters. Does not stack."
	PassiveInfo["SwordAscension"] = "Your sword mastery ascends, empowering sword techniques per point."
	PassiveInfo["Sword Mastery"] = "Adds directly to the Ascensions tally used in your sword damage, sword accuracy, and sword swing-delay formulas, after that tally's normal cap of 6 is already applied, giving +5% effect per point in each with no upper limit of its own."
	PassiveInfo["TaxThreshold"] = "Raises the threshold before wealth taxation applies."
	PassiveInfo["TechniqueMastery"] = "Reduces the cooldown of your skills. Each point adds 0.1 to an internal ratio, and cooldown time is divided by (1+ratio), reaching a maximum 60% reduction once the combined total reaches 15 points (the 2.5x cap). A net-negative total instead multiplies cooldowns up, worse the more negative it is."
	PassiveInfo["Tenacity"] = "When knocked below critical health (HealthAnnounce10<=1) in a serious fight, grants a chance to avoid being knocked out and instead revive with a small shield of temporary Vaizard HP. Each point adds 2.5% get-up chance on top of a flat 5% (10% instead with Neverending Hope), and adds to the temporary HP shield, clamped between 2 and 14."
	PassiveInfo["ThunderHerald"] = "Your critical hits call down lightning on the target. Does not stack."
	PassiveInfo["Tossing"] = "A second, independently-guaranteed throw triggers if Extra Secret Knives is also assigned."
	PassiveInfo["Toxic"] = "When you land a Poison-element hit, adds directly to the poison potency applied to the target (unless they are immune to poison or already resist the Poison element)."
	PassiveInfo["Trample"] = "While dashing, stun and launch effects do not stop you. Does not stack."
	PassiveInfo["TripleStrike"] = "Grants a chance to strike a third time on a swing where your double-strike has already procced. Chance = TripleStrike/(TripleStrike+3)*100 percent (e.g. 1 point = 25%, 3 points = 50%, 9 points = 75%)."
	PassiveInfo["UnarmedDamage"] = "Increases your unarmed damage by a percentage: each point adds 10% to a multiplier applied to unarmed strikes, beam clashes, and unarmed-scaling projectiles. Using an Unarmed style adds a further Signature-Technique-based bonus on top."
	PassiveInfo["Unbreakable"] = "Reduces the stat penalties ('taxes') applied while under a transformation or buff. Each point removes that fraction of incoming stat tax -- 0.1 gives a 10% reduction -- and the effect is unclamped, so values above 1.0 can zero out or invert the tax."
	PassiveInfo["UnderDog"] = "Grants a comeback bonus that scales with your current wound percentage: increases outgoing damage and reduces incoming damage the more injured you are. Each point adds 0.15% offense / 0.075% defense per 1% of TotalInjury; Humans, Half-Saiyans, Popo, Kamui, King of Braves, and Spiral characters receive a further 35% multiplier on top."
	PassiveInfo["Unstoppable"] = "Removes the max Health and Energy penalty normally imposed by accumulated wounds and fatigue, letting you heal and regenerate to full even while badly injured or exhausted. Does not stack."
	PassiveInfo["VenomImmune"] = "You cannot be poisoned: immune to both poison-hazard tiles (Ichor Water and variants) and the on-hit Poison-element debuff from attacks. Does not stack."
	PassiveInfo["VoidField"] = "When an attacker lands a spiritual-type attack against you, they gain Fatigue scaled by your VoidField value; the Fatigue gained shrinks as the attack's damage increases. Does not apply to non-spiritual attacks."
	PassiveInfo["Vortex"] = "When struck, you have a chance equal to your passive value to be swept away, travelling one tile per point in a random direction."
	PassiveInfo["Warping"] = "Lets your melee attacks warp you to the target from range. Warp-strike range equals the higher of an internal Warping value and your passive value (minimum 2 tiles)."
	PassiveInfo["WaterResist"] = "Reduces the damage/effect you take from Water-element sources. Each point of the passive is worth a fixed percentage of reduction, clamped between a minimum and maximum number of effective points."
	PassiveInfo["WaterWalk"] = "Lets you walk on water instead of swimming, and exempts you from water-tile hazards (Gravity and Hamon also qualify). Does not stack."
	PassiveInfo["WaveDancer"] = "Your projectile techniques ride a water wave: firing one also unleashes a Water Wave around you, on an internal cooldown. Does not stack."
	PassiveInfo["WeaponBreaker"] = "Your blows damage the durability of the target's equipped Sword, Staff, or Armor and can break it, reduced by the target's own item Quality tier. It also boosts the damage your melee attacks deal to terrain."
	PassiveInfo["WindAbsorb"] = "Wind-element attacks that would hit you heal you instead of dealing damage. Every Wind hit - melee, autohit, projectile, or beam - heals you for 10% of the incoming damage per point of WindAbsorb."
	PassiveInfo["WindRelease"] = "Each melee swing has a chance equal to 5% times your WindRelease value to release a gust of wind that knocks back every non-party enemy within a radius of 3 tiles times your WindRelease value, pushing them directly away from you. This deals no damage."
	PassiveInfo["Wuju"] = "Wuju discipline: your blade autohits are eligible to critically strike. Does not stack."
	PassiveInfo["Xenobiology"] = "Your alien biology confounds hunters: reduces Favored Prey bonus damage against you."
