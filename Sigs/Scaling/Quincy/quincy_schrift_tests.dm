/mob/Admin3/verb/Schrift_Test()
	set category = "Admin"
	set name = "Schrift Test"
	var/list/letters = QuincySchriftTestLetters()
	var/letter = Ask(usr, "Which letter do you test?", "Schrift Test", null, "pick", letters, 1)
	if(isnull(letter))
		return
	var/list/steps = QuincySchriftTestSteps(letter)
	var/step = Ask(usr, "Which step?", "Schrift Test", null, "pick", steps, 1)
	if(isnull(step))
		return
	var/out = usr.QuincySchriftTestRun(letter, step)
	usr << "<font color=#9fd8ff>[letter] / [step]: [out]</font>"
	Log("Admin", "[ExtractInfo(usr)] ran Schrift Test [letter] / [step].")

/proc/QuincySchriftTestLetters()
	return list("A", "B", "C", "D", "F", "G", "H", "I", "J", "L", "M", "O", "P", "Q", "R", "S", "T", "U", "W", "X", "Y", "Z")

/proc/QuincySchriftTestSteps(letter)
	switch(letter)
		if("A")
			return QuincyTestStepsA()
		if("B")
			return QuincyTestStepsB()
		if("C")
			return QuincyTestStepsC()
		if("D")
			return QuincyTestStepsD()
		if("F")
			return QuincyTestStepsF()
		if("G")
			return QuincyTestStepsG()
		if("H")
			return QuincyTestStepsH()
		if("I")
			return QuincyTestStepsI()
		if("J")
			return QuincyTestStepsJ()
		if("L")
			return QuincyTestStepsL()
		if("M")
			return QuincyTestStepsM()
		if("O")
			return QuincyTestStepsO()
		if("P")
			return QuincyTestStepsP()
		if("Q")
			return QuincyTestStepsQ()
		if("R")
			return QuincyTestStepsR()
		if("S")
			return QuincyTestStepsS()
		if("T")
			return QuincyTestStepsT()
		if("U")
			return QuincyTestStepsU()
		if("W")
			return QuincyTestStepsW()
		if("X")
			return QuincyTestStepsX()
		if("Y")
			return QuincyTestStepsY()
		if("Z")
			return QuincyTestStepsZ()
	return list()

/mob/proc/QuincySchriftTestRun(letter, step)
	var/mob/t = src.Target
	if(!ismob(t) || t == src)
		t = null
	switch(letter)
		if("A")
			return QuincyTestA(step, t)
		if("B")
			return QuincyTestB(step, t)
		if("C")
			return QuincyTestC(step, t)
		if("D")
			return QuincyTestD(step, t)
		if("F")
			return QuincyTestF(step, t)
		if("G")
			return QuincyTestG(step, t)
		if("H")
			return QuincyTestH(step, t)
		if("I")
			return QuincyTestI(step, t)
		if("J")
			return QuincyTestJ(step, t)
		if("L")
			return QuincyTestL(step, t)
		if("M")
			return QuincyTestM(step, t)
		if("O")
			return QuincyTestO(step, t)
		if("P")
			return QuincyTestP(step, t)
		if("Q")
			return QuincyTestQ(step, t)
		if("R")
			return QuincyTestR(step, t)
		if("S")
			return QuincyTestS(step, t)
		if("T")
			return QuincyTestT(step, t)
		if("U")
			return QuincyTestU(step, t)
		if("W")
			return QuincyTestW(step, t)
		if("X")
			return QuincyTestX(step, t)
		if("Y")
			return QuincyTestY(step, t)
		if("Z")
			return QuincyTestZ(step, t)
	return "unknown letter"
